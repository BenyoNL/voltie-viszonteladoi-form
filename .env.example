# Másold .env néven, és írd be az értékeket. A .env-et ne tedd verziókezelőbe.
MINICRM_SYSTEM_ID=
MINICRM_API_KEY=

# Viszonteladók + villanyszerelők kategória (alapértelmezés: a minicrm-69-mezok.json szerinti 69)
MINICRM_CATEGORY_ID=69
# Felelős felhasználó MiniCRM azonosítója (üresen: a program alapértéke, Tóth Bence) és a létrehozott feladat szövege (ajánlatkérés nélkül)
MINICRM_USER_ID=
MINICRM_TODO_TEXT=Viszonteladói csatlakozó
# Ha a kitöltő ajánlatot kért (töltő vagy dinamikus terheléskezelés), ez a feladat jön létre
MINICRM_TODO_CALL_TEXT=Hívd fel, kért töltőt
# Ide kerül minden válasz egyben ("Összes válasz" mező a 69-es kategóriában)
MINICRM_NOTE_FIELD=OsszesValasz2
# Többválasztós mezők küldési formája: comma (érték1,érték2), semicolon vagy array (JSON lista).
# A MiniCRM listaértékekben nincs vessző, mert a lista elválasztója a vessző.
MINICRM_MULTI_FORMAT=comma

PORT=3000
# Hibakereséshez: 1 esetén minden MiniCRM kérést és választ kiír a szerver.
MINICRM_DEBUG=
